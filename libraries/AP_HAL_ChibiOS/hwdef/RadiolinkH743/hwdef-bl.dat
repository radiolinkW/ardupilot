# hw definition file for the RadiolinkH743 bootloader

MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_RadiolinkH743

# The Betaflight target does not specify HSE; RadioLink boards use 8 MHz.
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

DEFAULTGPIO OUTPUT LOW PULLDOWN

PA4 IMU1_CS CS
PE11 IMU2_CS CS
PD7 OSD_CS CS

PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1
